# Copy to .env and fill in. Never commit .env.

MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/mytransport?appName=mytransport
PORT=5100
NODE_ENV=development

# Comma-separated list of allowed browser origins. "*" for local development only.
# This API is opened by browser apps carrying a bearer token, so a wildcard in
# production means any page on the internet can drive a signed-in session.
CORS_ORIGINS=*

# Signs the 12-hour session tokens for both products. Required: without it every
# sign-in throws inside jsonwebtoken and surfaces as a broken login rather than
# as a missing variable.
JWT_SECRET=change-me-to-a-long-random-string


# ================= clinic =================
#
# The clinic module is offline-first: the workbook on the clinic's own machine
# is the database, and this backend publishes bookable slots, collects the
# bookings made against them, and keeps a versioned backup of the workbook.

# Where the patient-facing site lives. Used to build the public clinic URL shown
# in the app's status tile, at sign-in and at registration.
# PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_BASE_URL=https://myclinicsolution.vercel.app

# Gates POST /auth/register for the clinic module.
#
# Signing up publishes a bookable page on the open internet and issues a
# licence, and there is no email verification in this build — so a shared code
# stands between that and a passing bot. Read from the environment so it can be
# rotated without a deploy; the fallback is the agreed value.
DEVELOPER_CODE=Srikanta@123

# Guards /api/v1/admin/* — creating clinics and rotating their API keys.
# The admin routes are NOT MOUNTED AT ALL unless this is set, so a deployment
# that does not provision clinics does not merely hide those endpoints.
ADMIN_SECRET=

# Guards /api/cron/retention — the sweep that removes expired slots and the
# bookings inside them. The route does not exist unless this is set: a public
# cron URL would be a public "delete everything expired" button.
# On Vercel this arrives as `Authorization: Bearer <CRON_SECRET>`.
#
# Note that the deletion ALSO happens on its own, through a MongoDB TTL index on
# Slot.expiresAt. This job exists to make it prompt and, more importantly, to
# COUNT it — the TTL monitor deletes silently, and a mechanism that removes
# patients' names without logging a number is indistinguishable from a bug.
CRON_SECRET=

# ================= how long a slot lives =================
#
# Slots are working memory, not records. Each one expires at the end of its own
# day in the clinic's timezone plus a retention window, and takes its bookings
# with it — names, telephone numbers and all.
#
# The window is per practice (Clinic.retentionHours, 48 by default), not an
# environment variable, so one clinic reconciling weekly can have a longer one
# without a deployment. It is listed here because it is the single most
# important number to understand about this product's data: ANYTHING THE CLINIC
# NEEDS TO KEEP MUST BE IN THEIR OWN WORKBOOK BEFORE THEN.


# ================= google drive (optional) =================
#
# The clinic's whole database is one .xlsx on one machine — fast, private, free,
# and one spilt coffee from total loss. These turn on the Drive endpoints.
#
# The customer pastes nothing: they press Connect, approve Google's consent
# screen, and the backend creates the folder and the file on the first upload
# and remembers both ids. It has to remember them, because the drive.file scope
# grants access only to files this app created — it cannot search their Drive
# for the workbook by name afterwards.
#
# The redirect URI must match Google's console CHARACTER FOR CHARACTER, with no
# trailing slash. A mismatch is redirect_uri_mismatch, and it is the single most
# common failure in this flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5100/api/v1/cloud/google/callback

# Encrypts the stored Google refresh token (AES-256-GCM) and signs the OAuth
# state parameter. Falls back to JWT_SECRET, but set it separately in production:
# a refresh token does not expire, so a leak of this key is a standing key to
# every connected practice's patient history.
CLOUD_ENCRYPTION_KEY=


# ================= cloud backup (S3, optional) =================
#
# The clinic's whole database is one .xlsx on one machine — fast, private, free,
# and one spilt coffee from total loss. These four turn on the backup endpoints.
# Leave them blank and /api/v1/backup answers "not configured" rather than
# failing: the feature is optional and the routes say so.
#
# The workbook goes browser -> Google directly on a signed URL. It never passes
# through this server, which is why a 6 MB file does not hit a serverless
# request limit and does not bill egress to your function.
GCS_BUCKET=
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
# Paste the key with its literal \n escapes exactly as the dashboard gives it —
# utils/gcs.js converts them. Without that conversion, signing fails with
# "error:0909006C:PEM routines:get_name:no start line", which names nothing.
GCP_PRIVATE_KEY=

# The bucket needs versioning ON and a CORS policy allowing PUT from your app's
# origin, or the browser upload fails with what looks like a bug in your code.
# See README, "Cloud backup".


# ================= notes =================
#
# MONEY. Every amount in this API is a Number of rupees with 2 decimal places.
# Not paise, not a string, not a Decimal128. Stated once, here, because the one
# thing that reliably breaks a billing system is two halves of it disagreeing
# about the unit — and the disagreement only ever surfaces on an invoice.
#
# CLINIC API KEYS are not configured here. They are minted per clinic — by
# POST /api/v1/auth/register or POST /api/v1/admin/clinics — shown once in that
# response, and stored only as a sha256 hash. There is no endpoint that can show
# one again; a lost key is rotated, not recovered.
#
# TIMEZONES. Each clinic carries its own IANA timezone and every expiry decision
# is made in it. There is no server-wide timezone setting, and there should not
# be one.
